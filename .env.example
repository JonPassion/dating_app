# --- Render.com (free tier) ---
# Set in Render dashboard or use render.yaml Blueprint:
#   DJANGO_ENV=production
#   DATABASE_URL=<auto from Render Postgres>
#   RENDER=true  (set automatically by render.yaml)
# Do NOT set REDIS_URL on free tier — app uses database cache instead.

# Environment: development | production
DJANGO_ENV=production
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_DEBUG=false

# PostgreSQL
POSTGRES_DB=unidate
POSTGRES_USER=unidate
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# Redis
REDIS_URL=redis://redis:6379/0

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Optional tuning
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=60
BROWSE_CACHE_TTL=300
DASHBOARD_STATS_CACHE_TTL=60
DRF_THROTTLE_USER=300/minute
DRF_THROTTLE_ANON=60/minute
SECURE_SSL_REDIRECT=true
